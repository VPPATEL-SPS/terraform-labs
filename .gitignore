# Terraform files
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# Allow .tfvars.example files for demonstration purposes
*.auto.tfvars
*.auto.tfvars.json

# Include override files are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform Lock Files (comment out if you want to commit lock files)
.terraform.lock.hcl

# Local .terraform directories
**/.terraform/*

# Terraform provider plugins
.terraform.lock.hcl

# Environment variable files
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db